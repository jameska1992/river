<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keeps the screen on during playback when the activity asks for it
         (FLAG_KEEP_SCREEN_ON). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Background audio: a mediaPlayback foreground service keeps the WebView
         alive with the screen off, and POST_NOTIFICATIONS (API 33+) lets it
         show the media notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.RiverMobile"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:allowBackup="false"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.RiverMobile"
            android:configChanges="orientation|keyboardHidden|screenSize|navigation|uiMode|fontScale|density">
            <!-- Orientation is intentionally NOT locked. The app is portrait-
                 first (phone layouts), but leaving it unspecified lets the
                 device rotate and lets the in-app video player request
                 landscape while it's on screen. configChanges keeps the
                 WebView (and its playback state) alive across rotation
                 instead of recreating the activity. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service backing background audio + the media
             notification. Not exported; driven only from within the app. -->
        <service
            android:name=".AudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
