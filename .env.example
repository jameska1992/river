# Copy to .env and fill in the required values before running docker compose up.

# --- Required ---

# Absolute path to your media directory on the host
MEDIA_PATH=/srv/media

# Absolute path where transcoded output is written on the host
OUTPUT_PATH=/srv/river-output

# Secret key for signing JWTs — use a long random string in production
JWT_SECRET=change-me-in-production

# Admin account created on first boot
ADMIN_PASSWORD=changeme

# TMDB API key — get one free at https://www.themoviedb.org/settings/api.
# Seeded into the database on first boot (like the Radarr/Sonarr keys);
# after that, manage it from the admin Settings → Metadata tab.
TMDB_API_KEY=

# --- Optional (defaults shown) ---

POSTGRES_PASSWORD=river
RABBITMQ_USER=river
RABBITMQ_PASSWORD=river

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@river.local

# How often river-scan rescans the media directory (a Go duration:
# 1h, 30m, 3600s). Seeded into the database on first boot; after that,
# manage it from the admin Settings → Scanning tab.
SCAN_INTERVAL=3600s

# ffmpeg worker counts
VIDEO_TRANS_WORKERS=2
AUDIO_TRANS_WORKERS=2
META_WORKERS=2

# JWT token lifetimes
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Radarr / Sonarr integration for the Requests feature — leave blank to disable.
# These are SEED values only: on first boot the river-init step copies them
# into the database if unset. After that, manage them from the admin
# Settings UI (edits there take effect without a restart and won't be
# overwritten on subsequent boots).
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=

# GPU transcoding (only used with docker-compose.gpu.yml)
NVIDIA_VISIBLE_DEVICES=all
