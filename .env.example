# Copy to .env and fill in the required values before running docker compose up.

# --- Required ---

# Absolute path to your media directory on the host
MEDIA_PATH=/srv/media

# Absolute path where transcoded output is written on the host
OUTPUT_PATH=/srv/river-output

# Secret key for signing JWTs — use a long random string in production
JWT_SECRET=change-me-in-production

# Admin account created on first boot
ADMIN_PASSWORD=changeme

# Least-privilege service account the internal services authenticate with
# (seeded automatically on boot). Optional: if unset, it defaults to
# ADMIN_PASSWORD, so existing deployments upgrade with no change. Set a
# distinct secret here to give the service account its own password.
# SERVICE_USERNAME=river-service
# SERVICE_PASSWORD=

# TMDB API key — get one free at https://www.themoviedb.org/settings/api.
# Seeded into the database on first boot (like the Radarr/Sonarr keys);
# after that, manage it from the admin Settings → Metadata tab.
TMDB_API_KEY=

# --- Optional (defaults shown) ---

POSTGRES_PASSWORD=river
RABBITMQ_USER=river
RABBITMQ_PASSWORD=river

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@river.local

# How often river-scan rescans the media directory (a Go duration:
# 1h, 30m, 3600s). Seeded into the database on first boot; after that,
# manage it from the admin Settings → Scanning tab.
SCAN_INTERVAL=3600s

# ffmpeg worker counts
VIDEO_TRANS_WORKERS=2
AUDIO_TRANS_WORKERS=2
META_WORKERS=2

# JWT token lifetimes
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Radarr / Sonarr integration for the Requests feature — leave blank to disable.
# These are SEED values only: on first boot the river-init step copies them
# into the database if unset. After that, manage them from the admin
# Settings UI (edits there take effect without a restart and won't be
# overwritten on subsequent boots).
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=

# GPU transcoding (only used with docker-compose.gpu.yml)
NVIDIA_VISIBLE_DEVICES=all

# --- Discord notifier (optional; only used with `--profile discord`) ---
# Posts a rich embed to Discord when a title is ready to watch. One-time setup
# (see river-discord/README.md): create a Discord incoming webhook, mint a
# read-only rvat_ API token, and create a river-api webhook targeting
# http://river-discord:8090/hooks/river — then paste its whsec_ secret here.
RIVER_DISCORD_API_TOKEN=
RIVER_DISCORD_WEBHOOK_SECRET=
DISCORD_WEBHOOK_URL=
# Optional JSON map of library-id OR media-type → Discord webhook URL.
DISCORD_ROUTES=
# Seconds to coalesce a burst (e.g. a season's episodes) into one message.
DISCORD_BATCH_WINDOW=10
# Comma-separated lifecycle kinds to notify on.
DISCORD_NOTIFY_KINDS=media.ready
